# Copy this file to .env (which is gitignored) and fill in the values.
# Never commit real values.

# Required by SEC fair-access rules: identify yourself as "Name email".
# Example format only: SEC_USER_AGENT="Jane Doe jane@example.com"
SEC_USER_AGENT=

# Optional: where the local Ollama server listens.
OLLAMA_HOST=http://localhost:11434
